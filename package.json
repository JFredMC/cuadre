{
  "name": "cuadre",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /cuadre/ && node scripts/postbuild-pages.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "description": "Cuadre: calculadoras laborales y de seguridad social para Colombia (valores 2026)",
  "license": "MIT",
  "author": "Jhon Maquilon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFredMC/cuadre.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  }
}
